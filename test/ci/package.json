{
  "name": "pi-kit-ci",
  "private": true,
  "description": "The kit's version pins: pi and the recommended packages that CI installs and tests (npm ci --ignore-scripts --prefix test/ci). Dependabot bumps these; packages.json must match (test/contracts.test.ts checks).",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "pi-subagents": "0.84.0",
    "pi-ask-user": "0.17.0",
    "@ff-labs/pi-fff": "0.11.0",
    "@juicesharp/rpiv-todo": "2.15.0"
  },
  "overrides": {
    "@earendil-works/pi-ai": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-mcp": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-tui": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-codemode": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-agent-core": "$@earendil-works/pi-coding-agent",
    "@earendil-works/pi-telemetry": "$@earendil-works/pi-coding-agent"
  }
}
