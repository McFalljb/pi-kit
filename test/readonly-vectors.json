{
  "about": "Shell commands a read-only session blocks (deny) or lets run (allow). One list for pi-kit's guardrails MUTATING (extensions/guardrails/core.ts, commandVerdict(cmd, true)) and pi-desk's port (tools/pi-desk-cli/readonly.odin, mutating): both must agree on every line. Copied from pi-kit's test/unit.test.ts read-only cases, plus edge cases of each regex.",
  "deny": [
    "git commit -m x",
    "git commit",
    "git push origin main",
    "git -C repo merge feature",
    "git rebase -i HEAD~3",
    "git reset --hard",
    "git checkout -b x",
    "git switch main",
    "git stash",
    "git apply p.diff",
    "git am < p.mbox",
    "git cherry-pick abc",
    "git revert abc",
    "git tag v1",
    "git branch -d old",
    "git branch  -D old",
    "git branch -m a b",
    "git worktree add ../wt",
    "git worktree remove ../wt",
    "git log --grep=commit",
    "/usr/bin/git commit",
    "rm x",
    "rm -rf build",
    "mv a b",
    "cp a b",
    "chmod +x f",
    "chown me f",
    "touch x",
    "mkdir -p d",
    "echo x | tee f",
    "ls; rm x",
    "cat rm.txt",
    "ssh nuc 'rm -rf /tmp/x'",
    "echo x > f",
    "echo x >f",
    "echo x >> f",
    "echo x>f",
    ">f",
    "cat a >> > b",
    "echo x > ./dev/null",
    "echo x >",
    "ssh nuc 'echo x > /etc/y'",
    "sed -i s/a/b/ f",
    "sed -i.bak s/a/b/ f",
    "sed -n -i p f",
    "sed  -e x -i f",
    "/usr/bin/sed -i x f",
    "sed -n p file-i.txt"
  ],
  "allow": [
    "ls -la",
    "git status",
    "git log --oneline -5",
    "git diff HEAD~1",
    "git show abc",
    "git branch",
    "git branch -a",
    "git worktree list",
    "git log | grep commit",
    "git log; echo commit",
    "echo x >/dev/null",
    "echo x > /dev/null",
    "echo x >>/dev/null",
    "cmd 2>&1",
    "cmd 2>/dev/null",
    "cmd &>/dev/null",
    "cmd >&2",
    "echo x > /dev/nullx",
    "a => b",
    "a -> b",
    "x>>>y",
    "grep -r term .",
    "scp-like",
    "format",
    "sed -n p f",
    "sed -e s/a/b/ f | head",
    "sed -n p f; echo -i",
    "used -i",
    "npm run dev",
    "python3 -c 'print(1)'",
    "ssh nuc uptime",
    "ssh nuc 'journalctl -u k3s --since -1h 2>&1 | tail'",
    "ssh nuc systemctl status traderv3",
    "curl -s https://example.com",
    "rmdir_like_name",
    "firm",
    "mvn test"
  ],
  "about_pidesk": "pi-desk only for now (not yet in pi-kit's MUTATING): deny_pidesk is blocked and allow_pidesk runs in pi-desk's port only; the pi-kit parity check reads deny and allow alone.",
  "deny_pidesk": [
    "git clean -fdx",
    "git restore f",
    "git pull",
    "git add .",
    "git init",
    "git config user.name x",
    "git update-ref refs/heads/x HEAD",
    "rmdir d",
    "unlink f",
    "ln -s a b",
    "cd x && ln a b",
    "truncate -s 0 f",
    "dd if=/dev/zero of=f bs=1 count=1",
    "find . -name '*.o' -delete",
    "perl -i -pe s/a/b/ f",
    "perl -pi -e s/a/b/ f",
    "perl -i.bak -pe x f",
    "curl -o out https://x",
    "curl -sSLo out https://x",
    "curl -O https://x/f",
    "curl --output out https://x",
    "curl --remote-name https://x/f",
    "curl -c jar https://x",
    "wget https://x/f",
    "wget -q -O- https://x",
    "tar xzf a.tgz",
    "tar -xf a.tar",
    "tar --extract -f a.tar",
    "tar czf out.tgz d",
    "tar -C d -xf a.tar",
    "sudo ln -s a b",
    "sudo -u root ln -s a b",
    "xargs wget",
    "xargs -n 1 wget",
    "env tar x",
    "env tar xf a.tar",
    "command rm f",
    "/bin/ln a b",
    "git -C . add f",
    "git -c a=b add .",
    "git --git-dir=.git add .",
    "git config --unset user.name",
    "git config --add x.y z",
    "git config set user.name x",
    "git config --global --replace-all x y",
    "git config --get x --unset y",
    "sh -c 'ln a b'",
    "bash -lc \"unlink f\"",
    "echo $(wget https://x)",
    "timeout 5 wget https://x",
    "x=1 truncate -s0 f",
    "if true; then unlink f; fi",
    "perl -0777 -i -pe s/a/b/ f",
    "perl -lpi -e s/a/b/ f",
    "nohup perl -pi -e x f",
    "cat x | xargs rmdir",
    "sudo -E ln a b",
    "env -i ln a b",
    "doas -n unlink f",
    "stdbuf -oL wget https://x",
    "nice -n 5 truncate -s0 f",
    "sudo -u root -E rmdir d",
    "xargs -0 -n 1 rmdir",
    "chroot / ln a b",
    "time -p wget https://x"
  ],
  "allow_pidesk": [
    "ls -ln",
    "git log --oneline",
    "git diff",
    "curl -s https://example.com",
    "curl -sSL https://x | head",
    "tar tzf a.tgz",
    "tar -tf a.tar",
    "tar --list -f a.tar",
    "find . -name '*.go'",
    "perl -ne 'print if /x/' f",
    "dd if=/dev/zero count=1 status=none",
    "git show HEAD:README.md",
    "echo hello",
    "git show HEAD:src/config.ts",
    "git diff -- src/init.ts",
    "git log -- add.md",
    "git config --get user.name",
    "git config --list",
    "git config --get-all remote.origin.url",
    "cat ln.txt",
    "grep -rn unlink src",
    "perl -MList::Util -e 1",
    "perl -Mstrict -e 1",
    "echo git add",
    "grep -rn 'wget' docs",
    "ls dd find",
    "xargs grep unlink",
    "sudo cat ln.txt",
    "env -i ls"
  ]
}
